diff --git a/quantum/keyboard.c b/quantum/keyboard.c
--- a/quantum/keyboard.c
+++ b/quantum/keyboard.c
@@ -18,6 +18,24 @@
 
 #include <stdint.h>
 #include "keyboard.h"
+
+#if defined(__SDCC_mcs51)
+bool IS_NOEVENT(const keyevent_t event) {
+    return event.type == TICK_EVENT;
+}
+bool IS_EVENT(const keyevent_t event) {
+    return event.type != TICK_EVENT;
+}
+bool IS_KEYEVENT(const keyevent_t event) {
+    return event.type == KEY_EVENT;
+}
+bool IS_COMBOEVENT(const keyevent_t event) {
+    return event.type == COMBO_EVENT;
+}
+bool IS_ENCODEREVENT(const keyevent_t event) {
+    return event.type == ENCODER_CW_EVENT || event.type == ENCODER_CCW_EVENT;
+}
+#endif
 #include "keycode_config.h"
 #include "matrix.h"
 #include "keymap_introspection.h"
