--- a/tmk_core/protocol/ch555/usb_device.c
+++ b/tmk_core/protocol/ch555/usb_device.c
@@ -148,6 +148,21 @@
 * Output         : None
 * Return         : None
 *******************************************************************************/ 
+/* Private to the USB ISR: no shared memcpy parameter/local storage. */
+#if defined(__SDCC_mcs51)
+static void usb_ep0_copy_isr(UINT8 __xdata *destination,
+                             const UINT8 *source,
+                             UINT16 length) __reentrant {
+    while (length != 0) {
+        *destination++ = *source++;
+        --length;
+    }
+}
+#define USB_EP0_COPY_ISR(destination, source, length) usb_ep0_copy_isr(destination, source, length)
+#else
+#define USB_EP0_COPY_ISR(destination, source, length) memcpy(destination, source, length)
+#endif
+
 #pragma save
 #pragma nooverlay
