diff --git a/quantum/logging/print.c b/quantum/logging/print.c
--- a/quantum/logging/print.c
+++ b/quantum/logging/print.c
@@ -31,3 +31,23 @@
 void putchar_(char character) {
     func(character);
 }
+
+#if defined(__SDCC_mcs51)
+#    include <stdio.h>
+#    include <stdarg.h>
+#    include "printf/printf.h"
+
+/* Preserve the MCS51 stdio UART sink; do not route through the null sendchar adapter. */
+static void mcs51_printf_uart(char character, void *context) {
+    (void)context;
+    (void)putchar((unsigned char)character);
+}
+
+int mcs51_printf(const char *format, ...) {
+    va_list arguments;
+    va_start(arguments, format);
+    int count = vfctprintf(mcs51_printf_uart, NULL, format, arguments);
+    va_end(arguments);
+    return count;
+}
+#endif
