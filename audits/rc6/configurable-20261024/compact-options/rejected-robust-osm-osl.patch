 bool ak820_tapping_process(keyrecord_t AK820_STATE_MEM *record);
 void ak820_tapping_cancel(void);
+
+#ifdef AK820_COMPACT_ONESHOT
+bool ak820_oneshot_process(keyrecord_t *record);
