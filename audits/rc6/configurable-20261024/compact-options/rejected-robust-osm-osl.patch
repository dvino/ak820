diff --git a/qmk-8051-ak820/keyboards/ajazz/ak820/ak820_tapping.c b/qmk-8051-ak820/keyboards/ajazz/ak820/ak820_tapping.c
index c12fcbc..7e53935 100644
--- a/qmk-8051-ak820/keyboards/ajazz/ak820/ak820_tapping.c
+++ b/qmk-8051-ak820/keyboards/ajazz/ak820/ak820_tapping.c
@@ -110,3 +110,79 @@ void ak820_tapping_cancel(void) {
         source_state[i] = (state & SOURCE_BLOCKED) | ((state & SOURCE_ACTIVE) << 1);
     }
 }
+
+#ifdef AK820_COMPACT_ONESHOT
+/* Pending and consumed modifiers own separate references. A consumed mask
+ * belongs to its accepted source until release, including rolled keys. */
+#define SOURCE_ONESHOT 8
+#define SOURCE_ONESHOT_USED 16
+static uint8_t oneshot_mods, oneshot_layers;
+static uint8_t oneshot_consumed[SOURCES];
+static void oneshot_layers_clear(void) {
+    for (uint8_t layer = 0; layer < MAX_LAYER; ++layer)
+        if (oneshot_layers & (1 << layer)) layer_hold_off(layer);
+    oneshot_layers = 0;
+}
+bool ak820_oneshot_process(keyrecord_t *record) {
+    uint8_t id = source(record->event.key), mods;
+    uint16_t code = record->keycode;
+    if (id == NONE || get_repeat_key_count()) return true;
+    if (code >= QK_ONE_SHOT_LAYER && code <= QK_ONE_SHOT_MOD_MAX) {
+        uint8_t value = code & 31;
+        bool is_mod = code >= QK_ONE_SHOT_MOD;
+        if (!is_mod && value >= MAX_LAYER) return false;
+        mods = value & 15;
+        if (value & 16) mods <<= 4;
+        if (record->event.pressed) {
+            source_state[id] |= SOURCE_ONESHOT;
+            source_state[id] &= ~SOURCE_ONESHOT_USED;
+            if (is_mod) register_mods(mods);
+            else layer_hold_on(value);
+        } else if (source_state[id] & SOURCE_ONESHOT) {
+            if (is_mod) {
+                if (!(source_state[id] & SOURCE_ONESHOT_USED)) {
+                    add_owned_mods(mods & ~oneshot_mods);
+                    oneshot_mods |= mods;
+                }
+                unregister_mods(mods);
+            } else {
+                if (!(source_state[id] & SOURCE_ONESHOT_USED) && !(oneshot_layers & (1 << value))) {
+                    layer_hold_on(value);
+                    oneshot_layers |= 1 << value;
+                }
+                layer_hold_off(value);
+            }
+            source_state[id] &= ~(SOURCE_ONESHOT | SOURCE_ONESHOT_USED);
+        }
+        return false;
+    }
+    /* Modifier and layer controls do not spend a queued One Shot. Resolved
+     * dual-role taps arrive here with their basic byte. */
+    if (record->event.pressed && code > KC_TRANSPARENT &&
+        !(code >= KC_LCTL && code <= KC_RGUI) &&
+        !(code >= QK_TO && code <= QK_LAYER_TAP_TOGGLE_MAX)) {
+        for (uint8_t i = 0; i < SOURCES; ++i)
+            if (source_state[i] & SOURCE_ONESHOT) source_state[i] |= SOURCE_ONESHOT_USED;
+        oneshot_consumed[id] |= oneshot_mods;
+        oneshot_mods = 0;
+    }
+    return true;
+}
+void ak820_oneshot_post(keyrecord_t *record) {
+    uint8_t id = source(record->event.key);
+    if (id == NONE || get_repeat_key_count()) return;
+    if (record->event.pressed) {
+        if (record->keycode > KC_TRANSPARENT &&
+            !(record->keycode >= KC_LCTL && record->keycode <= KC_RGUI) &&
+            !(record->keycode >= QK_TO && record->keycode <= QK_LAYER_TAP_TOGGLE_MAX))
+            oneshot_layers_clear();
+    } else if (oneshot_consumed[id]) {
+        unregister_mods(oneshot_consumed[id]);
+        oneshot_consumed[id] = 0;
+    }
+}
+void ak820_oneshot_cancel(void) {
+    oneshot_mods = oneshot_layers = 0;
+    for (uint8_t i = 0; i < SOURCES; ++i) oneshot_consumed[i] = 0;
+}
+#endif
