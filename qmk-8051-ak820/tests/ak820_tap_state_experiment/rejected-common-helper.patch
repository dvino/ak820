+#ifndef NO_ACTION_TAPPING
+/* Experimental common output stage. action_tapping.c has already resolved
+ * the shared MT/LT/OSM/OSL state machine before this function runs. */
+static void process_dual_role_action(keyrecord_t *record, action_t action) {
+    bool is_layer = action.kind.id == ACT_LAYER_TAP || action.kind.id == ACT_LAYER_TAP_EXT;
+    uint8_t value = is_layer ? action.layer_tap.val :
+        (action.kind.id == ACT_LMODS_TAP ? action.key.mods : action.key.mods << 4);
+#    ifdef HOLD_ON_OTHER_KEY_PRESS_PER_KEY
+    if (!is_layer && record->event.pressed && record->tap.count && record->tap.interrupted &&
+        get_hold_on_other_key_press(get_event_keycode(record->event, false), record)) {
+        record->tap.count = 0;
+    }
+#    endif
+    if (record->tap.count) {
+        if (record->event.pressed) {
+            register_code(action.key.code);
+        } else {
+            qs_wait_ms(action.key.code == KC_CAPS_LOCK ? QS_tap_hold_caps_delay : QS_tap_code_delay);
+            unregister_code(action.key.code);
+        }
+        return;
+    }
+    if (is_layer) {
+        if (record->event.pressed) layer_on(value);
+        else layer_off(value);
+    } else {
+        if (record->event.pressed) register_mods(value);
+        else {
+#    if defined(RETRO_TAPPING) && defined(DUMMY_MOD_NEUTRALIZER_KEYCODE)
+            if (retro_tapping_counter == 2) neutralize_flashing_modifiers(get_mods());
+#    endif
+            unregister_mods(value);
+        }
+    }
+}
